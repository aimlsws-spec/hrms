# ============================================================================
# HRMS Agent — environment configuration template
# Copy this file to `.env` in the project root and fill in real values.
# NEVER commit the real `.env` file — it is already listed in .gitignore.
# ============================================================================

# ── Primary application database (MySQL — the ONLY datastore this app owns) ──
# All employee, attendance, payroll, leave, and settings data lives here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=hrms

# ── Biometric device integration (IDMS / TimeWatch) ──────────────────────────
# This is the attendance-machine VENDOR's own database. It runs on Microsoft
# SQL Server (not MySQL) because that is what the hardware vendor ships — the
# backend only ever READS from it and syncs punches into the MySQL
# `biometric_raw_logs` table. This is the one intentional exception to
# "MySQL only": it is a third-party system we integrate with, not data we own.
#
# Requires the "ODBC Driver 17 for SQL Server" to be installed at the OS level
# on whichever machine runs the backend (see DEPLOYMENT_GUIDE.txt) — the
# `pyodbc` Python package alone is not enough.
TIMEWATCH_DEVICE_IDS=CHANGE_ME_DEVICE_SERIAL
TIMEWATCH_LOOKBACK_HOURS=2

IDMS_SERVER=CHANGE_ME_HOST\SQLEXPRESS
IDMS_DATABASE=idms
IDMS_USER=sa
IDMS_PASSWORD=changeme
IDMS_DRIVER=ODBC Driver 17 for SQL Server

# Column mapping for the vendor's user/employee table — the exact table and
# column names vary per installation. Run `python core/idms_inspect.py` and
# `python core/inspect_tblemployee.py` from backend/ against your real IDMS
# server to discover the correct values, then set them here.
IDMS_USER_TABLE=tbl_realtime_userinfo
IDMS_USER_ID_COL=user_id
IDMS_USER_FIRST_NAME_COL=user_name
IDMS_USER_LAST_NAME_COL=
IDMS_USER_DEPT_COL=
IDMS_USER_ACTIVE_FILTER=

# ── Biometric processor — shift defaults (Phase 4) ───────────────────────────
SHIFT_START_HOUR=9
SHIFT_START_MIN=30
SHIFT_END_HOUR=18
SHIFT_END_MIN=30
GRACE_MINUTES=15
HALF_DAY_THRESHOLD_HOURS=4.5

# ── WFH selfie evidence system ────────────────────────────────────────────────
# AES-256-GCM key for selfie encryption — 64 hex characters (32 bytes).
# Generate ONE per environment with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never rotate without a key-migration plan (existing files become unreadable).
# Never commit this value to Git.
SELFIE_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Directory where encrypted selfie files are stored. Must be outside the web
# root. Created automatically on startup.
WFH_SELFIE_DIR=wfh_selfies

# ── Email / OTP (currently unused by the backend — reserved for a future
#    OTP feature; safe to leave blank until that feature is implemented) ─────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
